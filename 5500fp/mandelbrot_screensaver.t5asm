; mandelbrot_screensaver.t5asm — generated by gen_mandelbrot_t5asm.py
; TernOO-5500FP native Mandelbrot with Fractint-style palette cycling
main:
    LI   R2, 512
    LI   R3, 384
    LI   R4, win_title
    LI   R1, 100        ; PIGART_OPEN_WINDOW
    SYSCALL
    LI   R22, 0   ; view index
next_view:
    ; load view params: R23=cx R24=cy R25=step
    LI   R26, views
    MULI R27, R22, 3
    ADD  R26, R26, R27
    LDW  R23, R26, 0
    LDW  R24, R26, 1
    LDW  R25, R26, 2
    CALL compute
    ; record view start time
    LI   R1, 110        ; GET_TICKS
    SYSCALL
    MOV  R21, R1
frame:
    LI   R1, 110
    SYSCALL
    MOV  R20, R1        ; now
    LI   R27, 80
    DIV  R19, R20, R27
    LI   R27, 24
    MOD  R19, R19, R27  ; palette phase
    CALL draw
    LI   R1, 107        ; PRESENT
    SYSCALL
poll:
    LI   R1, 108        ; POLL_EVENT
    SYSCALL
    BEQZ R1, polled     ; 0 = no more events
    LI   R27, 1         ; EVENT_CLOSE
    BEQ  R1, R27, quit
    LI   R27, 2         ; EVENT_KEY_DOWN → quit (screensaver!)
    BEQ  R1, R27, quit
    JMP  poll
polled:
    LI   R2, 16
    LI   R1, 109        ; SLEEP_MS
    SYSCALL
    SUB  R27, R20, R21
    LI   R28, 10000
    MULI R28, R28, 6   ; VIEW_MS composed (LI caps ±29524)
    BLT  R27, R28, frame
    ADDI R22, R22, 1
    LI   R27, 6
    MOD  R22, R22, R27
    JMP  next_view
quit:
    LI   R1, 111        ; CLOSE_WINDOW
    SYSCALL
    HALT

compute:
    LI   R30, 0         ; i
c_loop:
    LI   R27, 64
    MOD  R31, R30, R27  ; px
    DIV  R32, R30, R27  ; py
    SUBI R28, R31, 32
    MUL  R28, R28, R25
    ADD  R33, R23, R28  ; c_re
    SUBI R28, R32, 24
    MUL  R28, R28, R25
    ADD  R34, R24, R28  ; c_im
    LI   R35, 0         ; zx
    LI   R36, 0         ; zy
    LI   R39, 0         ; it
m_loop:
    MUL  R37, R35, R35
    LI   R27, 64
    DIV  R37, R37, R27  ; zx2
    MUL  R38, R36, R36
    DIV  R38, R38, R27  ; zy2
    ADD  R28, R37, R38
    LI   R29, 256
    BGT  R28, R29, m_done
    MUL  R28, R35, R36
    DIV  R28, R28, R27
    ADD  R28, R28, R28  ; 2*zx*zy/S
    ADD  R36, R28, R34  ; zy'
    SUB  R28, R37, R38
    ADD  R35, R28, R33  ; zx'
    ADDI R39, R39, 1
    LI   R29, 24
    BLT  R39, R29, m_loop
m_done:
    LI   R26, iters
    ADD  R26, R26, R30
    STW  R39, R26, 0
    ADDI R30, R30, 1
    LI   R27, 3072
    BLT  R30, R27, c_loop
    RET

draw:
    LI   R30, 0
d_loop:
    LI   R26, iters
    ADD  R26, R26, R30
    LDW  R39, R26, 0
    LI   R27, 24
    BGE  R39, R27, d_next   ; interior: draw nothing (set = silhouette)
    ADD  R28, R39, R19
    LI   R29, 24
    MOD  R28, R28, R29
    LI   R26, palette
    ADD  R26, R26, R28
    LDW  R6, R26, 0
d_col:
    LI   R27, 64
    MOD  R2, R30, R27
    MULI R2, R2, 8   ; x
    DIV  R3, R30, R27
    MULI R3, R3, 8   ; y
    LI   R4, 8
    LI   R5, 8
    LI   R7, 1          ; filled
    LI   R1, 102        ; DRAW_RECT
    SYSCALL
d_next:
    ADDI R30, R30, 1
    LI   R27, 3072
    BLT  R30, R27, d_loop
    RET

