  {
   "id": 7,
   "kind": "flow_io",
   "x": 600,
   "y": 565,
   "w": 250,
   "h": 44,
   "label": "strip \u21d0 glyph+strip",
   "name": "x_strip",
   "parent_scope": "decode_loop",
   "properties": [
    {
     "name": "direction",
     "value": "out"
    },
    {
     "name": "channel",
     "value": "variable"
    },
    {
     "name": "address",
     "value": "strip"
    },
    {
     "name": "expression",
     "value": "CONCAT(IF(t=1,\"+\",IF(t=0,\"0\",\"\u2212\")),IF(OR(i=18,i=22),\" \u00b7 \",\"\"), strip)"
    }
   ],
